<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.salvia95.cozy</groupId>
    <artifactId>cozy-parent</artifactId>
    <version>1.0.0</version>
    <relativePath>../cozy-parent/pom.xml</relativePath>
  </parent>

  <artifactId>cozy-test</artifactId>
  <name>Cozy :: Test</name>
  <description>상속형 아키텍처·렌더링·HTML·이벤트 호환 테스트</description>
  <url>https://github.com/Salvia95/cozy-framework</url>
  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <dependencies>
    <dependency>
      <groupId>io.salvia95.cozy</groupId>
      <artifactId>cozy-rules</artifactId>
    </dependency>
    <!-- 매니페스트·스펙 형식과 카탈로그 (UI가 있는 앱에서만 쓴다) -->
    <dependency>
      <groupId>io.salvia95.cozy</groupId>
      <artifactId>cozy-ui</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- 이벤트 호환 검사 (이벤트를 쓰는 앱에서만) -->
    <dependency>
      <groupId>io.salvia95.cozy</groupId>
      <artifactId>cozy-starter-events</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- 앱 테스트 기반: JUnit, AssertJ, Spring Test, MockMvc, Security Test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-test</artifactId>
    </dependency>

    <!-- 검사 1: ApplicationModules.verify() -->
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-core</artifactId>
    </dependency>

    <!-- 검사 4: vnu. 내장 검사에 필요 없는 서버·네트워크 부분과 log4j 1.x를 뺀다 (docs/adr/0022) -->
    <dependency>
      <groupId>nu.validator</groupId>
      <artifactId>validator</artifactId>
      <exclusions>
        <exclusion><groupId>log4j</groupId><artifactId>log4j</artifactId></exclusion>
        <exclusion><groupId>jakarta.servlet</groupId><artifactId>jakarta.servlet-api</artifactId></exclusion>
        <exclusion><groupId>org.apache.commons</groupId><artifactId>commons-fileupload2-core</artifactId></exclusion>
        <exclusion><groupId>org.apache.commons</groupId><artifactId>commons-fileupload2-jakarta-servlet6</artifactId></exclusion>
        <exclusion><groupId>org.eclipse.jetty</groupId><artifactId>jetty-server</artifactId></exclusion>
        <exclusion><groupId>org.eclipse.jetty</groupId><artifactId>jetty-security</artifactId></exclusion>
        <exclusion><groupId>org.eclipse.jetty</groupId><artifactId>jetty-session</artifactId></exclusion>
        <exclusion><groupId>org.eclipse.jetty.ee10</groupId><artifactId>jetty-ee10-servlets</artifactId></exclusion>
        <exclusion><groupId>org.eclipse.jetty</groupId><artifactId>jetty-alpn-client</artifactId></exclusion>
        <exclusion><groupId>org.eclipse.jetty.compression</groupId><artifactId>jetty-compression-gzip</artifactId></exclusion>
      </exclusions>
    </dependency>
    <!-- vnu가 쓰는 log4j 1.x API를 SLF4J(Logback)로 보낸다 -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>log4j-over-slf4j</artifactId>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <!-- 모듈 의존 규칙 (PRD §5, docs/adr/0019) -->
          <execution>
            <id>cozy-module-boundary</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <message>cozy-test는 cozy-rules에만 일반 의존하고, 다른 cozy 모듈은 optional로만 참조합니다 (PRD §5). optional 여부는 PomBoundaryTest가 검사합니다.</message>
                  <excludes>
                    <exclude>io.salvia95.cozy:*</exclude>
                  </excludes>
                  <includes>
                    <include>io.salvia95.cozy:cozy-rules</include>
                    <include>io.salvia95.cozy:cozy-starter-runtime</include>
                    <include>io.salvia95.cozy:cozy-starter-sqlite</include>
                    <include>io.salvia95.cozy:cozy-starter-events</include>
                    <include>io.salvia95.cozy:cozy-ui</include>
                  </includes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
