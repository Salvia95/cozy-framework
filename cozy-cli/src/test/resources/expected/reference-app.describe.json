{
  "app": {
    "basePackage": "io.salvia95.cozy.reference",
    "mainClass": "ReferenceApp",
    "cozyVersion": "1.1.0-SNAPSHOT",
    "starters": [
      "cozy-starter-events",
      "cozy-ui"
    ]
  },
  "modules": [
    {
      "name": "activity",
      "package": "io.salvia95.cozy.reference.activity",
      "dependsOn": [
        "memo :: spi"
      ],
      "facades": [],
      "finders": [
        {
          "type": "ActivityFinder",
          "methods": [
            "List<ActivityItem> recent(int limit)"
          ]
        }
      ],
      "dtos": [
        {
          "type": "ActivityItem",
          "fields": [
            "String message",
            "String at"
          ]
        }
      ],
      "events": [],
      "listeners": [
        {
          "type": "MemoCreatedListener",
          "method": "on",
          "on": "memo.MemoCreated"
        }
      ],
      "controllers": [],
      "screens": [],
      "fragments": [
        {
          "id": "activity/recent-activity",
          "signature": "recentActivity(items)"
        }
      ]
    },
    {
      "name": "dashboard",
      "package": "io.salvia95.cozy.reference.dashboard",
      "dependsOn": [
        "memo :: spi",
        "activity :: spi"
      ],
      "facades": [],
      "finders": [],
      "dtos": [],
      "events": [],
      "listeners": [],
      "controllers": [
        "DashboardController"
      ],
      "screens": [
        {
          "template": "dashboard/api/index",
          "spec": "src/main/resources/specs/dashboard-index.yml",
          "states": [
            "default",
            "empty"
          ]
        }
      ],
      "fragments": []
    },
    {
      "name": "memo",
      "package": "io.salvia95.cozy.reference.memo",
      "dependsOn": [],
      "facades": [
        {
          "type": "MemoFacade",
          "methods": [
            "long create(String title, String body, boolean pinned)",
            "boolean update(long id, String title, String body, boolean pinned)",
            "boolean delete(long id)"
          ]
        }
      ],
      "finders": [
        {
          "type": "MemoFinder",
          "methods": [
            "Optional<MemoItem> find(long id)",
            "List<MemoItem> list()",
            "MemoPage search(String query, boolean pinnedOnly, long offset, int limit)",
            "MemoSummary summary()"
          ]
        }
      ],
      "dtos": [
        {
          "type": "MemoItem",
          "fields": [
            "long id",
            "String title",
            "String body",
            "boolean pinned",
            "Instant createdAt",
            "Instant updatedAt"
          ]
        },
        {
          "type": "MemoPage",
          "fields": [
            "List<MemoItem> items",
            "long total"
          ]
        },
        {
          "type": "MemoSummary",
          "fields": [
            "long total",
            "long pinned",
            "String latestTitle"
          ]
        }
      ],
      "events": [
        {
          "type": "MemoCreated",
          "fields": [
            "long memoId",
            "String title"
          ],
          "publishedIn": [
            "src/main/java/io/salvia95/cozy/reference/memo/internal/app/command/MemoFacadeImpl.java"
          ]
        }
      ],
      "listeners": [],
      "controllers": [
        "MemoController"
      ],
      "screens": [
        {
          "template": "memo/api/detail",
          "spec": "src/main/resources/specs/memo-detail.yml",
          "states": [
            "default",
            "empty"
          ]
        },
        {
          "template": "memo/api/edit",
          "spec": "src/main/resources/specs/memo-edit.yml",
          "states": [
            "default",
            "empty",
            "invalid"
          ]
        },
        {
          "template": "memo/api/form",
          "spec": "src/main/resources/specs/memo-form.yml",
          "states": [
            "default",
            "empty",
            "invalid"
          ]
        },
        {
          "template": "memo/api/list",
          "spec": "src/main/resources/specs/memo-list.yml",
          "states": [
            "default",
            "empty",
            "noResults",
            "paged"
          ]
        }
      ],
      "fragments": [
        {
          "id": "memo/summary",
          "signature": "memoSummary(summary)"
        }
      ]
    }
  ],
  "slots": [],
  "problems": []
}
