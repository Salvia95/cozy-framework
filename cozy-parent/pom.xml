<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <!--
    앱과 프레임워크 모듈이 함께 상속하는 parent.
    구현 중에는 최신 GA를 쓴다.
    Spring 계열, Thymeleaf, Jackson, Flyway 등 Boot BOM이 관리하는 라이브러리는 Boot 버전을 따른다.
  -->
  <groupId>io.salvia95.cozy</groupId>
  <artifactId>cozy-parent</artifactId>
  <version>1.2.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Cozy :: Parent</name>

  <properties>
    <!-- 앱이 상속해도 프레임워크 버전을 가리키도록 리터럴로 둔다. project.version과의 일치는 enforcer가 검사한다. -->
    <cozy.version>1.2.0-SNAPSHOT</cozy.version>

    <java.version>25</java.version>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Boot BOM 밖의 라이브러리 (최신 GA) -->
    <spring-modulith.version>2.1.2</spring-modulith.version>
    <mybatis-spring-boot.version>4.1.0</mybatis-spring-boot.version>
    <sqlite-jdbc.version>3.54.1.0</sqlite-jdbc.version>
    <nu-validator.version>26.11.4</nu-validator.version>
    <attoparser.version>2.0.10.RELEASE</attoparser.version>

    <!-- Boot가 관리하는 플러그인 중 더 새로운 GA가 있는 것은 덮어쓴다 -->
    <maven-enforcer-plugin.version>3.7.0</maven-enforcer-plugin.version>
    <maven-invoker-plugin.version>3.10.1</maven-invoker-plugin.version>
    <maven-surefire-plugin.version>3.6.1</maven-surefire-plugin.version>
    <maven-failsafe-plugin.version>3.6.1</maven-failsafe-plugin.version>
    <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
    <!-- Boot가 관리하지 않는 플러그인 -->
    <maven-archetype-plugin.version>3.4.1</maven-archetype-plugin.version>
    <exec-maven-plugin.version>3.7.0</exec-maven-plugin.version>
    <license-maven-plugin.version>2.9.0</license-maven-plugin.version>

    <!--
      테스트 JVM 옵션. Mockito를 실행 중에 붙이지 않고 -javaagent로 올린다 (JDK가 동적 에이전트를 막을 예정).
      ${org.mockito:mockito-core:jar}는 dependency:properties가 채운다. Mockito가 없는 모듈은 이 값을 비운다.
    -->
    <cozy.test.argLine>-javaagent:${org.mockito:mockito-core:jar}</cozy.test.argLine>

    <!-- mvn -Pdist package (docs/conventions/distribution.md) -->
    <cozy.dist.minimum-version></cozy.dist.minimum-version>
    <cozy.dist.notes></cozy.dist.notes>
    <cozy.dist.java-options>-Xmx512m</cozy.dist.java-options>
    <cozy.dist.training>true</cozy.dist.training>
    <!--
      배포물에 들어가는 의존성의 허용 라이선스. 이름은 dist 프로필의 licenseMerges가 맞춘 SPDX ID다.
      이중 라이선스는 하나만 있으면 된다.
    -->
    <cozy.dist.allowed-licenses>Apache-2.0|MIT|BSD-2-Clause|BSD-3-Clause|EPL-1.0|EPL-2.0</cozy.dist.allowed-licenses>
    <cozy.java.executable>${java.home}/bin/java</cozy.java.executable>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Cozy -->
      <dependency>
        <groupId>io.salvia95.cozy</groupId>
        <artifactId>cozy-rules</artifactId>
        <version>${cozy.version}</version>
      </dependency>
      <dependency>
        <groupId>io.salvia95.cozy</groupId>
        <artifactId>cozy-starter-runtime</artifactId>
        <version>${cozy.version}</version>
      </dependency>
      <dependency>
        <groupId>io.salvia95.cozy</groupId>
        <artifactId>cozy-starter-sqlite</artifactId>
        <version>${cozy.version}</version>
      </dependency>
      <dependency>
        <groupId>io.salvia95.cozy</groupId>
        <artifactId>cozy-starter-events</artifactId>
        <version>${cozy.version}</version>
      </dependency>
      <dependency>
        <groupId>io.salvia95.cozy</groupId>
        <artifactId>cozy-ui</artifactId>
        <version>${cozy.version}</version>
      </dependency>
      <dependency>
        <groupId>io.salvia95.cozy</groupId>
        <artifactId>cozy-test</artifactId>
        <version>${cozy.version}</version>
      </dependency>
      <dependency>
        <groupId>io.salvia95.cozy</groupId>
        <artifactId>cozy-cli</artifactId>
        <version>${cozy.version}</version>
      </dependency>
      <dependency>
        <groupId>io.salvia95.cozy</groupId>
        <artifactId>cozy-workbench</artifactId>
        <version>${cozy.version}</version>
      </dependency>

      <!-- Spring Modulith (Boot BOM 밖) -->
      <dependency>
        <groupId>org.springframework.modulith</groupId>
        <artifactId>spring-modulith-bom</artifactId>
        <version>${spring-modulith.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- MyBatis -->
      <dependency>
        <groupId>org.mybatis.spring.boot</groupId>
        <artifactId>mybatis-spring-boot-starter</artifactId>
        <version>${mybatis-spring-boot.version}</version>
      </dependency>
      <dependency>
        <groupId>org.mybatis.spring.boot</groupId>
        <artifactId>mybatis-spring-boot-starter-test</artifactId>
        <version>${mybatis-spring-boot.version}</version>
      </dependency>

      <!-- SQLite -->
      <dependency>
        <groupId>org.xerial</groupId>
        <artifactId>sqlite-jdbc</artifactId>
        <version>${sqlite-jdbc.version}</version>
      </dependency>

      <!-- 템플릿 파서 (cozy-rules). Thymeleaf도 같은 버전을 쓰게 된다. -->
      <dependency>
        <groupId>org.attoparser</groupId>
        <artifactId>attoparser</artifactId>
        <version>${attoparser.version}</version>
      </dependency>

      <!-- 렌더링 결과 HTML 검사 (cozy-test, test scope). 서버용 전이 의존성 정리는 M4에서 한다. -->
      <dependency>
        <groupId>nu.validator</groupId>
        <artifactId>validator</artifactId>
        <version>${nu-validator.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <release>${maven.compiler.release}</release>
            <parameters>true</parameters>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <executions>
            <execution>
              <id>build-info</id>
              <goals>
                <goal>build-info</goal>
              </goals>
            </execution>
            <execution>
              <id>repackage</id>
              <goals>
                <goal>repackage</goal>
              </goals>
              <!-- dev 전용 도구(워크벤치와 그 엔진)는 실행 jar에 넣지 않는다. spring-boot:run에는 그대로 있다 -->
              <configuration>
                <excludes>
                  <exclude>
                    <groupId>io.salvia95.cozy</groupId>
                    <artifactId>cozy-workbench</artifactId>
                  </exclude>
                  <exclude>
                    <groupId>io.salvia95.cozy</groupId>
                    <artifactId>cozy-cli</artifactId>
                  </exclude>
                  <exclude>
                    <groupId>io.salvia95.cozy</groupId>
                    <artifactId>cozy-rules</artifactId>
                  </exclude>
                </excludes>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <argLine>${cozy.test.argLine}</argLine>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <configuration>
            <archive>
              <manifest>
                <!-- Implementation-Version: 화면 푸터의 버전 표시 -->
                <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
              </manifest>
            </archive>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-archetype-plugin</artifactId>
          <version>${maven-archetype-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>${exec-maven-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>license-maven-plugin</artifactId>
          <version>${license-maven-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- ${org.mockito:mockito-core:jar} 등 의존성 jar 경로를 속성으로 만든다 (테스트 -javaagent용) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>cozy-dependency-paths</id>
            <goals>
              <goal>properties</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <!-- 앱과 프레임워크 모듈 모두에 적용되는 규칙 -->
          <execution>
            <id>cozy-enforce</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[25,)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
                <dependencyConvergence/>
                <bannedDependencies>
                  <message>Cozy 금지 의존성입니다. JPA·Hibernate·H2·GraalVM과 Modulith 공식 이벤트 저장소는 쓰지 않습니다. 영속성은 cozy-starter-sqlite, 이벤트 저장은 cozy-starter-events를 쓰세요.</message>
                  <excludes>
                    <exclude>org.springframework.boot:spring-boot-starter-data-jpa</exclude>
                    <exclude>org.springframework.boot:spring-boot-data-jpa</exclude>
                    <exclude>org.springframework.boot:spring-boot-hibernate</exclude>
                    <exclude>org.springframework.boot:spring-boot-jpa</exclude>
                    <exclude>org.hibernate.orm:*</exclude>
                    <exclude>org.hibernate:hibernate-core</exclude>
                    <exclude>com.h2database:h2</exclude>
                    <exclude>org.springframework.modulith:spring-modulith-starter-jdbc</exclude>
                    <exclude>org.springframework.modulith:spring-modulith-starter-jpa</exclude>
                    <exclude>org.springframework.modulith:spring-modulith-starter-mongodb</exclude>
                    <exclude>org.springframework.modulith:spring-modulith-starter-neo4j</exclude>
                    <exclude>org.springframework.modulith:spring-modulith-events-jdbc</exclude>
                    <exclude>org.springframework.modulith:spring-modulith-events-jpa</exclude>
                    <exclude>org.springframework.modulith:spring-modulith-events-mongodb</exclude>
                    <exclude>org.springframework.modulith:spring-modulith-events-neo4j</exclude>
                    <exclude>log4j:log4j</exclude>
                    <exclude>org.graalvm.sdk:*</exclude>
                    <exclude>org.graalvm.nativeimage:*</exclude>
                  </excludes>
                </bannedDependencies>
                <bannedPlugins>
                  <message>GraalVM 네이티브 이미지는 쓰지 않습니다. 배포는 mvn -Pdist package(jpackage)로 합니다.</message>
                  <excludes>
                    <exclude>org.graalvm.buildtools:native-maven-plugin</exclude>
                  </excludes>
                </bannedPlugins>
              </rules>
            </configuration>
          </execution>
          <!-- 프레임워크 자신만: cozy.version 리터럴이 실제 버전과 같은지 -->
          <execution>
            <id>cozy-version-consistency</id>
            <inherited>false</inherited>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireProperty>
                  <property>cozy.version</property>
                  <regex>\Q${project.version}\E</regex>
                  <regexMessage>cozy-parent의 cozy.version(${cozy.version})이 project.version(${project.version})과 다릅니다. 둘을 같이 올리세요.</regexMessage>
                </requireProperty>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- 금지 의존성 규칙이 실제로 빌드를 실패시키는지 픽스처 앱으로 검증한다 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-invoker-plugin</artifactId>
        <inherited>false</inherited>
        <configuration>
          <cloneProjectsTo>${project.build.directory}/it</cloneProjectsTo>
          <streamLogsOnFailures>true</streamLogsOnFailures>
          <postBuildHookScript>verify</postBuildHookScript>
          <goals>
            <goal>validate</goal>
          </goals>
        </configuration>
        <executions>
          <execution>
            <id>cozy-parent-it</id>
            <goals>
              <goal>install</goal>
              <goal>run</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>cozy-windows</id>
      <activation>
        <os>
          <family>windows</family>
        </os>
      </activation>
      <properties>
        <cozy.java.executable>${java.home}\bin\java.exe</cozy.java.executable>
      </properties>
    </profile>

    <!-- 배포 패키지: app-image + AOT 캐시 + zip + 업데이트 매니페스트 -->
    <profile>
      <id>dist</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <executions>
              <execution>
                <id>cozy-dist-app</id>
                <goals>
                  <goal>enforce</goal>
                </goals>
                <configuration>
                  <rules>
                    <requireFilesExist>
                      <message>-Pdist는 Cozy 앱(src/main/resources/application.yml이 있는 모듈)에서 실행합니다. 프레임워크 레포에서는 -pl samples/reference-app처럼 앱만 고르세요.</message>
                      <files>
                        <file>${project.basedir}/src/main/resources/application.yml</file>
                      </files>
                    </requireFilesExist>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <!--
            제3자 라이선스 목록. 런타임 의존성만 본다. cozy 모듈도 목록에 들어간다(Apache-2.0).
            라이선스 정보가 없거나 허용 목록에 없으면 실패한다. CozyPackager가 결과를 다시 검사하고 실행 폴더의 licenses/에 담는다.
            - force: 결과 파일이 최신이면 플러그인이 검사를 건너뛰므로 매번 다시 만든다
            - useRepositoryMissingFiles=false: 원격 저장소에서 보충 파일을 찾지 않는다 (오프라인 빌드)
          -->
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>license-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>cozy-third-party</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>add-third-party</goal>
                </goals>
                <configuration>
                  <outputDirectory>${project.build.directory}/dist-licenses</outputDirectory>
                  <addOutputDirectoryAsResourceDir>false</addOutputDirectoryAsResourceDir>
                  <excludedScopes>test,provided,system</excludedScopes>
                  <!-- dev 전용 도구는 실행 jar에 넣지 않으므로 목록에서도 뺀다 -->
                  <excludedArtifacts>cozy-workbench|cozy-cli|cozy-rules</excludedArtifacts>
                  <useRepositoryMissingFiles>false</useRepositoryMissingFiles>
                  <deployMissingFile>false</deployMissingFile>
                  <failOnMissing>true</failOnMissing>
                  <failOnBlacklist>true</failOnBlacklist>
                  <force>true</force>
                  <sortArtifactByName>true</sortArtifactByName>
                  <includedLicenses>${cozy.dist.allowed-licenses}</includedLicenses>
                  <licenseMerges>
                    <licenseMerge>Apache-2.0|Apache License, Version 2.0|The Apache Software License, Version 2.0|Apache License 2.0|The Apache License, Version 2.0|Apache 2.0|Apache License Version 2.0|Apache Software License - Version 2.0|ASF 2.0</licenseMerge>
                    <licenseMerge>MIT|MIT License|The MIT License|The MIT License (MIT)|MIT license</licenseMerge>
                    <licenseMerge>BSD-2-Clause|BSD 2-Clause|The BSD 2-Clause License|BSD-2-Clause License|Simplified BSD License</licenseMerge>
                    <licenseMerge>BSD-3-Clause|BSD 3-Clause|The BSD 3-Clause License|BSD-3-Clause License|New BSD License|Revised BSD License|BSD License 3</licenseMerge>
                    <licenseMerge>EPL-1.0|Eclipse Public License 1.0|Eclipse Public License - v 1.0|Eclipse Public License v1.0</licenseMerge>
                    <licenseMerge>EPL-2.0|EPL 2.0|Eclipse Public License 2.0|Eclipse Public License v2.0|Eclipse Public License - v 2.0</licenseMerge>
                  </licenseMerges>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <!--
            같은 package 단계에서 repackage가 먼저 돌아야 한다. 부모 프로필의 플러그인은 앱 POM의 플러그인보다 앞에 놓이므로
            spring-boot-maven-plugin을 여기서 exec보다 먼저 선언해 순서를 고정한다.
          -->
          <plugin>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-maven-plugin</artifactId>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>cozy-dist</id>
                <phase>package</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${cozy.java.executable}</executable>
                  <classpathScope>runtime</classpathScope>
                  <arguments>
                    <argument>-cp</argument>
                    <classpath/>
                    <argument>io.salvia95.cozy.runtime.internal.dist.CozyPackager</argument>
                    <argument>--jar=${project.build.directory}/${project.build.finalName}.jar</argument>
                    <argument>--out=${project.build.directory}/dist</argument>
                    <argument>--work=${project.build.directory}/dist-work</argument>
                    <argument>--version=${project.version}</argument>
                    <argument>--minimum-version=${cozy.dist.minimum-version}</argument>
                    <argument>--notes=${cozy.dist.notes}</argument>
                    <argument>--java-options=${cozy.dist.java-options}</argument>
                    <argument>--training=${cozy.dist.training}</argument>
                    <argument>--licenses=${project.build.directory}/dist-licenses/THIRD-PARTY.txt</argument>
                    <argument>--allowed-licenses=${cozy.dist.allowed-licenses}</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
