<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.salvia95.cozy</groupId>
    <artifactId>cozy-parent</artifactId>
    <version>1.0.0</version>
    <relativePath>../cozy-parent/pom.xml</relativePath>
  </parent>

  <artifactId>cozy-starter-events</artifactId>
  <name>Cozy :: Starter Events</name>
  <description>SQLite 이벤트 발행 기록 + 인박스</description>
  <url>https://github.com/Salvia95/cozy-framework</url>
  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <dependencies>
    <dependency>
      <groupId>io.salvia95.cozy</groupId>
      <artifactId>cozy-starter-sqlite</artifactId>
    </dependency>
    <!-- 발행 기록 레지스트리, @ApplicationModuleListener. 저장소는 Cozy가 SQLite로 직접 구현한다 (ADR-0006) -->
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-events-core</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <!-- 모듈 의존 규칙 (PRD §5, docs/adr/0019) -->
          <execution>
            <id>cozy-module-boundary</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <message>스타터 의존은 events → sqlite → runtime 한 방향만 허용합니다 (PRD §5). cozy-starter-events는 cozy-starter-sqlite와 cozy-starter-runtime에만 의존합니다.</message>
                  <excludes>
                    <exclude>io.salvia95.cozy:*</exclude>
                  </excludes>
                  <includes>
                    <include>io.salvia95.cozy:cozy-starter-sqlite</include>
                    <include>io.salvia95.cozy:cozy-starter-runtime</include>
                  </includes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
