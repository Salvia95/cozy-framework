# 번들에 담는 JDK: Eclipse Temurin. add-jdk.sh, jdk-sources.sh, verify-offline.sh가 읽는다 (bash로 source한다).
# 판을 올릴 때는 Adoptium API(api.adoptium.net/v3/assets/release_name/eclipse/<릴리스>)의 checksum과
# 릴리스 자산의 .sha256.txt가 같은지 확인하고 세 파일의 이름과 SHA-256을 함께 바꾼다.
JDK_RELEASE=jdk-25.0.5.1+2
JDK_URL=https://github.com/adoptium/temurin25-binaries/releases/download/jdk-25.0.5.1%2B2
# Windows x64: 릴리스로 내는 번들 (2026-11-21 확인)
JDK_WINDOWS_X64=OpenJDK25U-jdk_x64_windows_hotspot_25.0.5.1_2.zip
JDK_WINDOWS_X64_SHA256=849d380ab0a64d9098e7d3a2de28beb73841c3b255c8284f019ccd8748c5eb5b
# Linux x64: 번들 JDK로 오프라인 검증을 돌리는 데 쓴다 (2026-11-21 확인)
JDK_LINUX_X64=OpenJDK25U-jdk_x64_linux_hotspot_25.0.5.1_2.tar.gz
JDK_LINUX_X64_SHA256=760f91b22c3efc9bd1b64ff950598231be82928cc807e30691a0e7a2995a62c0
# 소스 묶음: JDK를 담은 번들과 같은 릴리스에 올린다 (2026-11-21 확인)
JDK_SOURCES=OpenJDK25U-jdk-sources_25.0.5.1_2.tar.gz
JDK_SOURCES_SHA256=3fb4af3a690f6c0f47462f3f813a8f09dc4a237f0c6ab462a764f15bc15313a7
