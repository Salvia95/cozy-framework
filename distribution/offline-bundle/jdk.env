# 번들에 담는 JDK: Eclipse Temurin. add-jdk.sh, jdk-sources.sh, verify-offline.sh가 읽는다 (bash로 source한다).
# 판을 올릴 때는 Adoptium API(api.adoptium.net/v3/assets/release_name/eclipse/<릴리스>)의 checksum과
# 릴리스 자산의 .sha256.txt가 같은지 확인하고 세 파일의 이름과 SHA-256을 함께 바꾼다.
JDK_RELEASE=jdk-25.0.5+8
JDK_URL=https://github.com/adoptium/temurin25-binaries/releases/download/jdk-25.0.5%2B8
# Windows x64: 릴리스로 내는 번들 (2026-11-12 확인)
JDK_WINDOWS_X64=OpenJDK25U-jdk_x64_windows_hotspot_25.0.5_8.zip
JDK_WINDOWS_X64_SHA256=636bdc13dc649ddc7d5921c5c7d23cca6e44fd19d662b45cc9c02135a6c96c42
# Linux x64: 번들 JDK로 오프라인 검증을 돌리는 데 쓴다 (2026-11-12 확인)
JDK_LINUX_X64=OpenJDK25U-jdk_x64_linux_hotspot_25.0.5_8.tar.gz
JDK_LINUX_X64_SHA256=68982529869257d0ee6b824ec5aa270ff8b118bb438670da0b97ebdab178d7fb
# 소스 묶음: JDK를 담은 번들과 같은 릴리스에 올린다 (2026-11-12 확인)
JDK_SOURCES=OpenJDK25U-jdk-sources_25.0.5_8.tar.gz
JDK_SOURCES_SHA256=f331d870d998f9c144c361c220960f8ad2de169dc1b1c4dc4145291c501c2341
