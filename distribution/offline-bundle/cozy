#!/usr/bin/env bash
# Cozy command (offline bundle). Usage: cozy <action> [args...]
#
#   ./cozy install [folder]          Install the bundle on this PC. Run it in the bundle folder (default: ~/cozy)
#   cozy new [-D<name>=<value> ...]  Create a new app under the current folder. Answer the prompts or pass -D values
#   cozy version                     Print the framework version
#   cozy help                        Print this help, then the app commands of cozy-cli
#
# Installing puts cozy and mvn in <folder>/bin. Add <folder>/bin to PATH to use cozy and the bundled Maven anywhere.
# With a bundled JDK (jdk/), cozy and its mvn run on it. Otherwise they use the system JDK 25 (JAVA_HOME, PATH).
# Options of new: groupId, artifactId, package, appId (default: artifactId), appName (may be Korean), persistence (default: true),
# events (default: false, needs persistence).
#   cozy new -DgroupId=com.example -DartifactId=voc-assistant -Dpackage=com.example.voc \
#            -DappName="VOC 도우미" -Dpersistence=true -Devents=false -DinteractiveMode=false
set -euo pipefail

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# 번들 폴더는 cozy 옆에 COZY_VERSION이 있고, 설치 폴더는 bin/cozy의 한 단계 위에 있다
if [ -f "$SELF/COZY_VERSION" ]; then ROOT="$SELF"; else ROOT="$(dirname "$SELF")"; fi
VERSION="$(cat "$ROOT/COZY_VERSION" 2>/dev/null || true)"
# Maven이 쓰는 사용자 저장소. 설치한 Maven의 settings.xml이 같은 곳(${env.HOME}/.local/share/cozy/repository)을 가리킨다
USER_REPOSITORY="$HOME/.local/share/cozy/repository"

# 번들의 JDK는 이 명령 안에서만 쓴다. 시스템의 JAVA_HOME과 PATH 설정은 바꾸지 않는다
if [ -x "$ROOT/jdk/bin/java" ]; then
  export JAVA_HOME="$ROOT/jdk"
  export PATH="$JAVA_HOME/bin:$PATH"
fi

# 머리의 # 줄들, 그리고 cozy-cli를 실행할 수 있으면 그 도움말(앱 명령)
usage() {
  awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "${BASH_SOURCE[0]}"
  local jar="$ROOT/lib/cli/cozy-cli.jar"
  if [ -f "$jar" ] && command -v java > /dev/null; then
    echo
    java -jar "$jar" help 2> /dev/null || true
  fi
}

need_java() {
  local major
  major="$(java -XshowSettings:properties -version 2>&1 | sed -n 's/^ *java.specification.version = //p')"
  if ! command -v java > /dev/null || [ -z "$major" ] || [ "$major" -lt 25 ]; then
    echo "[cozy] JDK 25가 필요합니다. JAVA_HOME과 PATH를 확인하세요." >&2
    exit 1
  fi
}

# 이전 설치의 저장소에만 있는 파일(이전 판의 cozy 모듈, 그 판만 쓰는 의존성, 예전 설치가 쓴 앱)을 사용자 저장소로 옮긴다.
# 새 번들에도 있는 파일, 사용자 저장소에 이미 있는 파일, Maven의 잠금 파일은 그대로 둔다
keep_old_files() {
  local old="$1" new="$2" file moved=0
  while IFS= read -r -d '' file; do
    file="${file#./}"
    if [ -e "$new/$file" ] || [ -e "$USER_REPOSITORY/$file" ]; then continue; fi
    mkdir -p "$USER_REPOSITORY/$(dirname "$file")"
    mv "$old/$file" "$USER_REPOSITORY/$file"
    moved=$((moved + 1))
  done < <(cd "$old" && find . -type f ! -path './.locks/*' -print0)
  if [ "$moved" -gt 0 ]; then
    echo "[cozy] 이전 판에만 있던 파일 ${moved}개를 사용자 저장소로 옮겼습니다: $USER_REPOSITORY"
  fi
}

install() {
  local dest="${1:-$HOME/cozy}" zip maven_dir
  zip="$(ls "$ROOT"/apache-maven-*-bin.zip 2>/dev/null | head -1 || true)"
  if [ -z "$zip" ] || [ ! -d "$ROOT/repository" ]; then
    echo "[cozy] install은 번들 폴더(repository/와 apache-maven-*-bin.zip이 있는 곳)의 ./cozy로 실행합니다." >&2
    exit 1
  fi
  need_java
  mkdir -p "$dest"
  dest="$(cd "$dest" && pwd)"
  maven_dir="$dest/$(basename "$zip" -bin.zip)"
  rm -rf "$maven_dir"
  (cd "$dest" && unzip -q "$zip")
  mkdir -p "$USER_REPOSITORY"
  if [ "$ROOT/repository" != "$dest/repository" ]; then
    if [ -d "$dest/repository" ]; then keep_old_files "$dest/repository" "$ROOT/repository"; fi
    rm -rf "$dest/repository"
    cp -r "$ROOT/repository" "$dest/repository"
  fi
  rm -rf "$dest/docs" "$dest/licenses" "$dest/bin" "$dest/lib"
  cp -r "$ROOT/docs" "$ROOT/licenses" "$dest/"
  cp "$ROOT/LICENSE" "$ROOT/NOTICE" "$ROOT/COZY_VERSION" "$dest/"
  mkdir -p "$dest/bin" "$dest/lib"
  cp "$ROOT/cozy" "$ROOT/cozy.cmd" "$dest/bin/"
  cp "$ROOT/cozy.ps1" "$dest/lib/"
  cp -r "$ROOT/lib/cli" "$dest/lib/"
  chmod +x "$dest/bin/cozy"
  # JDK: 이전 번들의 JDK가 남지 않게 지우고, 이 번들에 있으면 복사한다
  if [ "$ROOT/jdk" != "$dest/jdk" ]; then
    rm -rf "$dest/jdk"
    if [ -d "$ROOT/jdk" ]; then cp -r "$ROOT/jdk" "$dest/jdk"; fi
  fi
  # bin/mvn: 설치 폴더의 Maven을 부른다. 설치 폴더에 JDK가 있으면 그 JDK로 돈다
  cat > "$dest/bin/mvn" <<SH
#!/usr/bin/env bash
# 설치 폴더의 Maven을 실행한다. 설치 폴더에 JDK(jdk/)가 있으면 그 JDK로 실행한다 (cozy install이 만든 파일)
COZY_HOME="\$(cd "\$(dirname "\${BASH_SOURCE[0]}")/.." && pwd)"
if [ -x "\$COZY_HOME/jdk/bin/java" ]; then export JAVA_HOME="\$COZY_HOME/jdk"; fi
exec "\$COZY_HOME/$(basename "$maven_dir")/bin/mvn" "\$@"
SH
  chmod +x "$dest/bin/mvn"

  # Maven은 사용자 저장소에 쓰고, Maven 폴더 옆의 번들 저장소는 읽기만 한다(꼬리).
  # 절대 경로를 쓰지 않으므로 설치 폴더를 옮겨도 맞다. 사용자 저장소는 다시 설치하거나 지워도 남는다
  cat > "$maven_dir/conf/settings.xml" <<XML
<?xml version="1.0" encoding="UTF-8"?>
<!-- Cozy 오프라인 번들 $VERSION: 사용자 저장소와 번들 저장소만 쓰고 네트워크에 나가지 않는다 -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0">
  <localRepository>\${env.HOME}/.local/share/cozy/repository</localRepository>
  <offline>true</offline>
  <profiles>
    <profile>
      <id>cozy-bundle</id>
      <properties>
        <maven.repo.local.tail>\${maven.home}/../repository</maven.repo.local.tail>
      </properties>
    </profile>
  </profiles>
  <activeProfiles>
    <activeProfile>cozy-bundle</activeProfile>
  </activeProfiles>
</settings>
XML

  echo "[cozy] 설치했습니다: $dest"
  echo "  저장소:      $USER_REPOSITORY (Maven이 쓰는 곳. 다시 설치하거나 지워도 남는다)"
  if [ -d "$dest/jdk" ]; then
    echo "  JDK:         $dest/jdk (cozy와 mvn이 쓴다. 시스템 설정은 바꾸지 않았다)"
  fi
  echo "  PATH에 추가: export PATH=\"$dest/bin:\$PATH\""
  echo "  새 앱:       cozy new"
}

new_app() {
  local mvn
  mvn="$(ls -d "$ROOT"/apache-maven-*/bin 2>/dev/null | head -1 || true)"
  if [ -z "$mvn" ] || [ ! -x "$mvn/mvn" ]; then
    echo "[cozy] 설치한 폴더의 cozy로 실행합니다. 번들 폴더라면 먼저 ./cozy install을 실행하세요." >&2
    exit 1
  fi
  need_java
  # 설치한 Maven은 conf/settings.xml이 번들 저장소를 가리키고 항상 오프라인이다
  exec "$mvn/mvn" -o -ntp org.apache.maven.plugins:maven-archetype-plugin:3.4.1:generate -DarchetypeCatalog=local \
    -DarchetypeGroupId=io.salvia95.cozy -DarchetypeArtifactId=cozy-archetype -DarchetypeVersion="$VERSION" \
    -Dversion=1.0.0-SNAPSHOT "$@"
}

# describe, check, recipes, add, link, enable, sync, set, migrate, attach, remove, rename, channel, update, upgrade는 cozy-cli가 한다. 번들 저장소의 cozy-ui jar를 읽는다.
# 설치 폴더(COZY_HOME)를 알려 주면 cozy-cli가 그 COZY_VERSION으로 지금 판을 알고, cozy upgrade가 그 폴더에 다시 설치한다
cli() {
  local jar="$ROOT/lib/cli/cozy-cli.jar"
  if [ ! -f "$jar" ]; then
    echo "[cozy] $jar가 없습니다. 번들을 다시 설치하세요." >&2
    exit 2
  fi
  need_java
  COZY_HOME="$ROOT" COZY_REPOSITORY="${COZY_REPOSITORY:-$USER_REPOSITORY:$ROOT/repository}" exec java -jar "$jar" "$@"
}

ACTION="${1:-help}"
[ "$#" -gt 0 ] && shift
case "$ACTION" in
  install) install "$@" ;;
  new) new_app "$@" ;;
  describe|check|recipes|add|link|enable|sync|set|migrate|attach|remove|rename|channel|update|upgrade) cli "$ACTION" "$@" ;;
  version|--version|-v) echo "${VERSION:-unknown}" ;;
  help|--help|-h) usage ;;
  *)
    echo "[cozy] 알 수 없는 동작: $ACTION" >&2
    usage >&2
    exit 2
    ;;
esac
