<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.salvia95.cozy</groupId>
    <artifactId>cozy-parent</artifactId>
    <version>1.1.0</version>
    <relativePath>../cozy-parent/pom.xml</relativePath>
  </parent>

  <artifactId>cozy-ui</artifactId>
  <name>Cozy :: UI</name>
  <description>Tabler·htmx·Pretendard 자산, 공용 fragment, 패턴 카탈로그</description>
  <url>https://github.com/Salvia95/cozy-framework</url>
  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <dependencies>
    <dependency>
      <groupId>io.salvia95.cozy</groupId>
      <artifactId>cozy-starter-runtime</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>
    <!-- 폼 검증 (@Valid + BindingResult) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <!-- 모듈 의존 규칙 -->
          <execution>
            <id>cozy-module-boundary</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <message>cozy-ui는 cozy-starter-runtime에만 의존합니다.</message>
                  <excludes>
                    <exclude>io.salvia95.cozy:*</exclude>
                  </excludes>
                  <includes>
                    <include>io.salvia95.cozy:cozy-starter-runtime</include>
                  </includes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
