<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.salvia95.cozy</groupId>
    <artifactId>cozy-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../cozy-parent/pom.xml</relativePath>
  </parent>

  <!--
    M6 완료 기준: reference-app v1.0.0 → v1.1.0 자동 업데이트(데이터 보존), 실패하는 v1.1.1 자동 롤백.
    reference-app을 세 버전으로 -Pdist 패키징하고, 실제 app-image를 실행해 업데이트한다.
    jpackage와 훈련 실행으로 몇 분 걸리므로 e2e 프로필에서만 돈다: mvn -Pe2e install (docs/conventions/distribution.md)
  -->
  <artifactId>cozy-dist-e2e</artifactId>
  <name>Cozy :: Samples :: Dist E2E</name>
  <description>배포·자체 업데이트 종단 검증 (PRD §9.4, §9.6, M6)</description>

  <properties>
    <maven.install.skip>true</maven.install.skip>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.salvia95.cozy</groupId>
      <artifactId>cozy-starter-runtime</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- 패키징할 reference-app 사본이 쓰는 모듈. 리액터가 이 모듈보다 먼저 설치하게 한다 -->
    <dependency>
      <groupId>io.salvia95.cozy</groupId>
      <artifactId>cozy-starter-events</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.salvia95.cozy</groupId>
      <artifactId>cozy-ui</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.salvia95.cozy</groupId>
      <artifactId>cozy-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <forkedProcessTimeoutInSeconds>2400</forkedProcessTimeoutInSeconds>
          <systemPropertyVariables>
            <cozy.e2e.maven-home>${maven.home}</cozy.e2e.maven-home>
            <!-- settings.offline은 Boolean이라 그대로 넣지 못한다. 문자열 안에 넣어 "offline=true"로 넘긴다 -->
            <cozy.e2e.mode>offline=${settings.offline}</cozy.e2e.mode>
            <cozy.e2e.local-repository>${settings.localRepository}</cozy.e2e.local-repository>
            <cozy.e2e.reference-app>${project.basedir}/../reference-app</cozy.e2e.reference-app>
            <cozy.e2e.work>${project.build.directory}/e2e</cozy.e2e.work>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
