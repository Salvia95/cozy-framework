<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- 앱과 똑같이 cozy-parent만 상속하고 스타터에만 의존한다 -->
  <parent>
    <groupId>io.salvia95.cozy</groupId>
    <artifactId>cozy-parent</artifactId>
    <version>1.2.0-SNAPSHOT</version>
    <relativePath>../../cozy-parent/pom.xml</relativePath>
  </parent>

  <artifactId>cozy-reference-app</artifactId>
  <name>Cozy :: Reference App</name>
  <description>모든 규칙과 스타터를 실제로 쓰는 통합 검증용 앱 (memo, activity, dashboard)</description>

  <properties>
    <maven.install.skip>true</maven.install.skip>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.salvia95.cozy</groupId>
      <artifactId>cozy-starter-events</artifactId>
    </dependency>
    <dependency>
      <groupId>io.salvia95.cozy</groupId>
      <artifactId>cozy-ui</artifactId>
    </dependency>
    <!-- 테스트 기반: 아키텍처·렌더링 검사, JUnit, MockMvc, Security Test -->
    <dependency>
      <groupId>io.salvia95.cozy</groupId>
      <artifactId>cozy-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
