<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.salvia95.cozy</groupId>
    <artifactId>cozy-parent</artifactId>
    <version>1.0.0</version>
    <relativePath>../../cozy-parent/pom.xml</relativePath>
  </parent>

  <artifactId>cozy-violations</artifactId>
  <name>Cozy :: Samples :: Violations</name>
  <description>규칙별 의도적 위반 픽스처 (PRD §6.2, §6.5). 배포하지 않는다.</description>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <!-- invoker:install이 검사 픽스처가 쓰는 cozy 산출물을 로컬 저장소에 설치하도록 모두 의존한다 -->
  <dependencies>
    <dependency>
      <groupId>io.salvia95.cozy</groupId>
      <artifactId>cozy-starter-runtime</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.salvia95.cozy</groupId>
      <artifactId>cozy-ui</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.salvia95.cozy</groupId>
      <artifactId>cozy-starter-sqlite</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.salvia95.cozy</groupId>
      <artifactId>cozy-starter-events</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.salvia95.cozy</groupId>
      <artifactId>cozy-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- checks/*: cozy-test 검사(C1~C8)마다 그 검사에서 실패하는 작은 앱. 실패해야 성공이고, verify.groovy가 실패 이유를 확인한다 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-invoker-plugin</artifactId>
        <configuration>
          <projectsDirectory>checks</projectsDirectory>
          <cloneProjectsTo>${project.build.directory}/checks</cloneProjectsTo>
          <streamLogsOnFailures>true</streamLogsOnFailures>
          <postBuildHookScript>verify</postBuildHookScript>
          <parallelThreads>4</parallelThreads>
        </configuration>
        <executions>
          <execution>
            <id>cozy-check-fixtures</id>
            <goals>
              <goal>install</goal>
              <goal>run</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
