<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- 루트 aggregator. 모든 cozy-* 모듈은 하나의 버전으로 함께 릴리스한다 (PRD §5). -->
  <groupId>io.salvia95.cozy</groupId>
  <artifactId>cozy-build</artifactId>
  <version>1.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Cozy :: Build</name>

  <modules>
    <module>cozy-parent</module>
    <module>cozy-rules</module>
    <module>cozy-starter-runtime</module>
    <module>cozy-starter-sqlite</module>
    <module>cozy-starter-events</module>
    <module>cozy-ui</module>
    <module>cozy-test</module>
    <module>cozy-cli</module>
    <module>cozy-archetype</module>
    <module>samples/reference-app</module>
    <module>samples/violations</module>
  </modules>

  <!-- aggregator는 cozy-parent를 상속하지 않는다. install 플러그인을 모듈과 같은 버전(Boot 관리 3.1.4)으로 맞춰 오프라인 install이 되게 한다 -->
  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>3.1.4</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <!-- 배포·자체 업데이트 종단 검증 (M6). jpackage로 몇 분 걸린다: mvn -Pe2e install -->
    <profile>
      <id>e2e</id>
      <modules>
        <module>samples/dist-e2e</module>
      </modules>
    </profile>
  </profiles>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- aggregator 자체는 배포하지 않는다 -->
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.install.skip>true</maven.install.skip>
  </properties>
</project>
