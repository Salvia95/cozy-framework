<?xml version="1.0" encoding="UTF-8"?>
<!--
  Cozy 앱 아키타입 (PRD §6.6, §10). 문서: docs/conventions/getting-started.md
  옵션 조합의 검사와 옵션별 파일 제거는 META-INF/archetype-post-generate.groovy가 한다.
-->
<archetype-descriptor xmlns="https://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.2.0"
                      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                      xsi:schemaLocation="https://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.2.0 https://maven.apache.org/xsd/archetype-descriptor-1.2.0.xsd"
                      name="cozy-app">

  <requiredProperties>
    <!-- 영문 소문자·숫자와 단어 사이 하이픈. 데이터 폴더와 실행 파일 이름이 된다 -->
    <requiredProperty key="appId">
      <defaultValue>${artifactId}</defaultValue>
      <validationRegex>^[a-z0-9]+(-[a-z0-9]+)*$</validationRegex>
    </requiredProperty>
    <!-- 화면 표시명. 한글을 쓸 수 있다 -->
    <requiredProperty key="appName">
      <defaultValue>${appId}</defaultValue>
    </requiredProperty>
    <!-- SQLite + MyBatis + Flyway (cozy-starter-sqlite) -->
    <requiredProperty key="persistence">
      <defaultValue>true</defaultValue>
      <validationRegex>^(true|false)$</validationRegex>
    </requiredProperty>
    <!-- 모듈 사이 이벤트 (cozy-starter-events). persistence=true가 필요하다 -->
    <requiredProperty key="events">
      <defaultValue>false</defaultValue>
      <validationRegex>^(true|false)$</validationRegex>
    </requiredProperty>
    <!-- 아키타입 jar는 .gitignore를 담지 못해 __gitignore__로 두고 생성할 때 이 이름으로 바꾼다. 값을 바꾸지 않는다 -->
    <requiredProperty key="gitignore">
      <defaultValue>.gitignore</defaultValue>
    </requiredProperty>
  </requiredProperties>

  <fileSets>
    <fileSet filtered="true" packaged="true" encoding="UTF-8">
      <directory>src/main/java</directory>
      <includes>
        <include>**/*.java</include>
      </includes>
    </fileSet>
    <fileSet filtered="true" packaged="true" encoding="UTF-8">
      <directory>src/test/java</directory>
      <includes>
        <include>**/*.java</include>
      </includes>
    </fileSet>
    <!-- 앱 이름, 패키지 이름이 들어가는 파일 -->
    <fileSet filtered="true" encoding="UTF-8">
      <directory>src/main/resources</directory>
      <includes>
        <include>application.yml</include>
        <include>application-dev.yml</include>
        <include>specs/**</include>
        <include>mapper/**</include>
      </includes>
    </fileSet>
    <!-- Thymeleaf·SQL·JSON은 Velocity가 건드리지 않게 그대로 복사한다 -->
    <fileSet filtered="false" encoding="UTF-8">
      <directory>src/main/resources</directory>
      <includes>
        <include>templates/**</include>
        <include>cozy/**</include>
        <include>db/**</include>
      </includes>
    </fileSet>
    <fileSet filtered="false" encoding="UTF-8">
      <directory>src/test/resources</directory>
      <includes>
        <include>**</include>
      </includes>
    </fileSet>
    <fileSet filtered="true" encoding="UTF-8">
      <directory>.run</directory>
      <includes>
        <include>*.xml</include>
      </includes>
    </fileSet>
    <fileSet filtered="false" encoding="UTF-8">
      <directory></directory>
      <includes>
        <include>AGENTS.md</include>
        <include>__gitignore__</include>
      </includes>
    </fileSet>
  </fileSets>
</archetype-descriptor>
